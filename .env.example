# HTTP server
HTTP_HOST=0.0.0.0
HTTP_PORT=8080

# PostgreSQL
POSTGRES_USER=app_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=family_expenses
# Keep these credentials in sync with POSTGRES_USER and POSTGRES_PASSWORD.
DATABASE_URL=postgres://app_user:change_me@postgres:5432/family_expenses?sslmode=disable

# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# LLM
LLM_BASE_URL=your_llm_base_url
LLM_API_KEY=your_llm_api_key
LLM_MODEL=gpt-6-astra

# Default time zone
TZ_NAME=Europe/Moscow

# Optional comma-separated Telegram user IDs.
# Note: the setting is currently loaded by config but is not enforced by the app.
ALLOWED_USER_IDS=
